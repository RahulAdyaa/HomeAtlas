# Copy to .env.local for native setup, or .env for Docker Compose. Generate fresh secrets.
DATABASE_URL=postgres://homeatlas:homeatlas@127.0.0.1:54329/homeatlas
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WORKER_KEY=replace-with-at-least-32-random-characters
WORKER_URL=http://127.0.0.1:8001
STORAGE_ROOT=.data/storage
GENERATION_MODEL=qwen3-vl:4b-instruct
OLLAMA_URL=http://127.0.0.1:11434
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TEXT_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
IMAGE_EMBEDDING_MODEL=google/siglip2-base-patch16-224
IMAGE_EMBEDDING_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
OCR_BACKEND=tesseract
MAX_UPLOAD_BYTES=52428800
MAX_MEDIA_SECONDS=900
MONTHLY_CREDITS=100
CREDIT_COST_UPLOAD=5
CREDIT_COST_QUESTION=1
CREDIT_COST_IMAGE_QUESTION=3
CREDIT_COST_VOICE_QUESTION=3
# Local email is written privately to .data/mail. Required for a local production-build smoke test:
ALLOW_LOCAL_MAIL=true
# Real deployment must use SMTP, set ALLOW_LOCAL_MAIL=false and HTTPS BETTER_AUTH_URL.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=HomeAtlas <hello@your-domain.example>
